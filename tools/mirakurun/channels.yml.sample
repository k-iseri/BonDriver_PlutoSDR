# Mirakurun 4.x の channels.yml（recpluto 用）
# 地デジは Mirakurun の走査 API で作れる:
#   curl -X PUT "http://127.0.0.1:40772/api/config/channels/scan?type=GR&minCh=13&maxCh=52&refresh=true"
# CATV（ISDB-C）は Mirakurun の走査対象外なので、`recpluto --scan catv` の出力（channel と MER）を元に書く。
# serviceId は Mirakurun のサービス走査が埋める（type は BS / CS のどちらかに分ける）。
- name: NHK総合
  type: GR
  channel: '27'          # UHF 物理チャンネル
- name: NHK BS
  type: BS
  channel: 'C56'         # ケーブル TV の物理チャンネル（C13〜C63）。BS/CS 再送信（ISDB-C トラモジ）
  serviceId: 101
